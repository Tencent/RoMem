{
  "data_path": "dataset/FinTMMBench",
  "search_limit": 50,
  "answer_context_size": "3,5,10",
  "answer_llm_model": "gpt-5.2",
  "exp_name": "fintmmbench_romem",
  "memory_framework": "romem",
  "romem_save_dir": "outputs/romem_fintmmbench",
  "romem_llm_model": "gpt-5-mini",
  "romem_embedding_model": "text-embedding-3-small",
  "romem_openie_mode": "online",
  "enable_tkge_tunnel": true,
  "tkge_temporal_backbone": "chronor",
  "tkge_time_source": "happen",
  "tkge_time_contrastive_weight": 0.5,
  "tkge_time_loss_type": "listwise",
  "tkge_num_time_negatives": 8,
  "tkge_time_sigma_years": 0.25,
  "tkge_time_neg_jitter_years": 0.02,
  "tkge_time_neg_far_days": 365,
  "tkge_time_neg_min_days_start": 90,
  "tkge_time_neg_min_days_end": 3,
  "tkge_time_neg_min_days_decay_epochs": 60,
  "tkge_time_sigma_years_start": 0.5,
  "tkge_time_sigma_years_end": 0.02,
  "tkge_time_sigma_decay_epochs": 300,
  "tkge_temporal_warmup_epochs": 100,
  "tkge_checkpoint_start_epoch": 110,
  "tkge_steps_per_update": 500,
  "romem_tkge_verbose": 1,
  "tkge_time_gate_checkpoint": "outputs/pretrain_gate_data/alpha_r_pretrained.pt",
  "use_llm_fact_filter": true
}
