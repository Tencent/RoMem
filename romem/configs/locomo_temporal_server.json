{
  "data_path": "dataset/locomo/raw/locomo10_temporal.json",
  "max_examples": 0,
  "neo4j_uri": "bolt://localhost:7687",
  "neo4j_user": "neo4j",
  "neo4j_password": "password",
  "neo4j_database": "neo4j",
